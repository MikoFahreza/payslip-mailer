# Database (Postgres Neon Serverless via Vercel Marketplace)
DATABASE_URL="postgres://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# Auth.js v5 / NextAuth
# Generate secret: openssl rand -base64 32 (atau: npx auth secret)
AUTH_SECRET="replace-with-32-plus-char-random-secret"

# URL Dasar Aplikasi (WAJIB sesuai origin saat di lokal maupun produksi Vercel)
# Contoh lokal: http://localhost:3000
# Contoh Vercel: https://email-payslip.vercel.app
# Catatan: Di Vercel tidak perlu mengisi AUTH_URL; Auth.js otomatis membaca domain dari request.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 (Khusus untuk fitur "Hubungkan Gmail" di /app/settings -> /api/gmail/connect)
# Daftarkan Redirect URI berikut di Google Cloud Console:
# - <ORIGIN>/api/gmail/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Token Encryption Key (32 byte dalam format Base64 untuk enkripsi AES-256-GCM refresh token Gmail)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-encryption-key"

# Vercel Blob (Client Direct Upload)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Email Mode:
# - "simulate" : Simulasi pengiriman di server (tanpa mengirim email riil lewat Gmail)
# - "live"     : Kirim email riil memakai koneksi Gmail masing-masing pengguna (fallback simulasi bila Gmail belum terhubung)
EMAIL_MODE="simulate"

# Metadata Publik Aplikasi
NEXT_PUBLIC_APP_NAME="Payslip Mailer"
