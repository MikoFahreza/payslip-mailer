# Database (Postgres Neon Serverless via Vercel Marketplace)
DATABASE_URL="postgres://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth
# Generate a secret with `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET="super-secret-auth-key-change-in-production-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Same OAuth client for Login and Gmail incremental auth)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Token Encryption Key (32 bytes, base64 for AES-256-GCM encrypted refresh tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="your-32-byte-base64-encryption-key"

# Vercel Blob (Client Upload)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Email Mode: "live" (Gmail API) | "simulate" (Mock logger for dev/testing)
EMAIL_MODE="simulate"

# Public App Metadata
NEXT_PUBLIC_APP_NAME="Payslip Mailer"
